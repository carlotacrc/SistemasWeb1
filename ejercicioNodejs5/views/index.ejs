<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
  </head>
  <body>
    <nav style="background: #f4f4f4; padding: 12px 16px; margin-bottom: 20px;">
      <strong style="margin-right: 15px;">Navbar</strong>
      <a href="/" style="margin-right: 10px;">Home</a>
      <a href="/login">Login</a>
    </nav>

    <h1><%= title %></h1>
    <p>Welcome to Index</p>

    <div style="margin: 20px 0;">
      <a href="/login">
        <button style="padding: 6px 14px; cursor: pointer;">Hacer login</button>
      </a>
    </div>

    <hr style="margin: 20px 0; border: 0; border-top: 1px solid #ddd;" />

    <h2>Lista de elementos desde el servidor:</h2>
    <ul>
      <% cursos.forEach(function(item) { %>
        <li><strong><%= item.nombre %></strong> — <em><%= item.categoria %></em></li>
      <% }); %>
    </ul>
  </body>
</html>